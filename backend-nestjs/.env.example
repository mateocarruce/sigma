# --- Base de datos (deben coincidir con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=glosas_db
DB_USER=hospital_admin
DB_PASSWORD=changeme_en_env

# --- JWT ---
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=8h

# --- App ---
PORT=3000
NODE_ENV=development

# --- Microservicio IA (se usará en el módulo 4) ---
IA_SERVICE_URL=http://localhost:8000

# --- Anonimización (DEBE coincidir con el HASH_SALT usado en scripts-etl) ---
HASH_SALT=cambiar_este_salt_en_produccion
